# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Test server ID for fast guild-scoped command deployment during dev.
# Leave empty to deploy commands globally (~1 hour to propagate).
DISCORD_GUILD_ID=

# Fish Audio API key (fish.audio -> API Keys).
FISH_AUDIO_API_KEY=
# Optional: voice used when /ask has no voice picked. Paste a voice ID from its fish.audio URL.
# Defaults to the most-used public voice.
FISH_AUDIO_DEFAULT_VOICE_ID=
# Optional: Fish Audio TTS model (s2.1-pro, s2-pro, s1, s2.1-pro-free).
FISH_AUDIO_MODEL=s2.1-pro

# OpenRouter API key used to answer questions (openrouter.ai -> Keys).
OPENROUTER_API_KEY=
# Optional: any OpenRouter model ID.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional: let the AI add [laughing], [excited], [whispering]... voice cues. Set to false for plain delivery.
FISH_AUDIO_EMOTIONS=true
